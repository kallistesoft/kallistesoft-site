# Apache settings for kallistesoft.ca on the GoDaddy hosting.
DirectoryIndex index.html
ErrorDocument 404 /404.html

# http:// and www. → https://kallistesoft.ca (GitHub Pages used to do this;
# cPanel's Force HTTPS switch doesn't cover this domain).
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.kallistesoft\.ca$ [NC]
RewriteRule ^ https://kallistesoft.ca%{REQUEST_URI} [R=301,L]

# The home page opens in the browser's language: French stays at /, anything
# else goes to /en/. The FR/EN links store the visitor's choice in a lang cookie
# (assets/site.js), which wins. No Accept-Language (crawlers) stays at /.
RewriteCond %{HTTP_COOKIE} (^|;\s*)lang=en(;|$)
RewriteRule ^$ /en/ [R=302,L]
RewriteCond %{HTTP_COOKIE} !(^|;\s*)lang=fr(;|$)
RewriteCond %{HTTP:Accept-Language} !^$
RewriteCond %{HTTP:Accept-Language} !^fr [NC]
RewriteRule ^$ /en/ [R=302,L]

# Neon Breaker was renamed Brick Shatter: Neon Breaker.
RewriteRule ^(en/)?neon-breaker(/.*)?$ https://kallistesoft.ca/$1brick-shatter/ [R=301,L]

# Caching: HTML is always revalidated; CSS/JS are referenced with ?v=… so
# they can be cached for a day (bump the version in every page when they
# change); images for a month.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
