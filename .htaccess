# Apache settings for kallistesoft.ca on the GoDaddy hosting.
DirectoryIndex index.html
ErrorDocument 404 /404.html

# http:// and www. → https://kallistesoft.ca (GitHub Pages used to do this;
# cPanel's Force HTTPS switch doesn't cover this domain).
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.kallistesoft\.ca$ [NC]
RewriteRule ^ https://kallistesoft.ca%{REQUEST_URI} [R=301,L]

# Short links for the social profiles: the games section, with the platform as the source (assets/site.js then
# tags every Google Play link with it).
RewriteRule ^yt/?$ /en/?src=youtube#games [R=302,NE,L]
RewriteRule ^ig/?$ /en/?src=instagram#games [R=302,NE,L]
RewriteRule ^tt/?$ /en/?src=tiktok#games [R=302,NE,L]

# The home page opens in the browser's language: French stays at /, anything
# else goes to /en/. The FR/EN links store the visitor's choice in a lang cookie
# (assets/site.js), which wins. No Accept-Language (crawlers) stays at /.
RewriteCond %{HTTP_COOKIE} (^|;\s*)lang=en(;|$)
RewriteRule ^$ /en/ [R=302,L]
RewriteCond %{HTTP_COOKIE} !(^|;\s*)lang=fr(;|$)
RewriteCond %{HTTP:Accept-Language} !^$
RewriteCond %{HTTP:Accept-Language} !^fr [NC]
RewriteRule ^$ /en/ [R=302,L]

# Mathnut links to /mathnut/privacy and /mathnut/terms, one URL for both languages: French browsers get
# the French page, everyone else (and crawlers) the English one; the lang cookie (FR/EN links) wins. Its
# first builds, as "Jardin des maths", linked to /jardin-des-maths/…, which now lands on the same pages.
# mathnut/privacy/ and mathnut/terms/ hold a small fallback page in case these rules don't run.
RewriteRule ^jardin-des-maths/(privacy|terms)/?$ /mathnut/$1/ [R=301,L]
RewriteRule ^jardin-des-maths/?$ /mathnut/ [R=301,L]
RewriteCond %{HTTP_COOKIE} (^|;\s*)lang=fr(;|$) [OR]
RewriteCond %{HTTP:Accept-Language} ^fr [NC]
RewriteCond %{HTTP_COOKIE} !(^|;\s*)lang=en(;|$)
RewriteRule ^mathnut/privacy/?$ /confidentialite/mathnut/ [R=302,L]
RewriteRule ^mathnut/privacy/?$ /en/privacy/mathnut/ [R=302,L]
RewriteCond %{HTTP_COOKIE} (^|;\s*)lang=fr(;|$) [OR]
RewriteCond %{HTTP:Accept-Language} ^fr [NC]
RewriteCond %{HTTP_COOKIE} !(^|;\s*)lang=en(;|$)
RewriteRule ^mathnut/terms/?$ /conditions/mathnut/ [R=302,L]
RewriteRule ^mathnut/terms/?$ /en/terms/mathnut/ [R=302,L]

# Neon Breaker was renamed Brick Shatter: Neon Breaker.
RewriteRule ^(en/)?neon-breaker(/.*)?$ https://kallistesoft.ca/$1brick-shatter/ [R=301,L]

# Caching: HTML is always revalidated; CSS/JS are referenced with ?v=… so
# they can be cached for a day (bump the version in every page when they
# change); images for a month.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# stats-lib.php is only included by hit.php and stats.php.
<Files "stats-lib.php">
  Require all denied
</Files>
